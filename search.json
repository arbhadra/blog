---
layout: null
---
{% include published-posts.html %}
[
  {% for e in published %}
  {% assign e_path = "posts/" | append: e.slug | append: "/index.md" %}
  {% assign e_page = site.pages | where: "path", e_path | first %}
  {
    "title": {{ e.title | jsonify }},
    "url": {{ "/posts/" | append: e.slug | append: "/" | relative_url | jsonify }},
    "date": {{ e.date | date: "%B %-d, %Y" | jsonify }},
    "tags": {{ e.tags | join: " " | jsonify }},
    "summary": {{ e.summary | strip_html | strip_newlines | jsonify }},
    "content": {{ e_page.content | strip_html | strip_newlines | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
